// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId String @id @unique @db.VarChar(30)
  name   String @db.VarChar(50)
  email  String @unique @db.VarChar(50)
  role   Role   @default(WORKER)
  compId    String?          @db.VarChar(30)
  company    Company?    @relation(fields: [compId], references: [compId]) // Relación opcional con el modelo Company
  projects   Project[]   @relation("UserProjects")
  department Department? @relation(fields: [deptId], references: [deptId])
  deptId     String?

  departmen_Manager Departmen_Manager[]
  user_Projects     User_Projects[]

  boss_relations User_Relations[] @relation("BossRelations")

  worker_relations User_Relations[] @relation("SubordinatedRelations")
  
}

model Company {
  compId      String       @id @unique @db.VarChar(30)
  name        String       @db.VarChar(50)
  projects    Project[]
  departments Department[]
  users       User[]
}

model Project {
  projId        String          @id @unique @db.VarChar(30)
  name          String          @db.VarChar(50)
  compId        String
  settings      String?
  company       Company         @relation(fields: [compId], references: [compId])
  users         User[]          @relation("UserProjects")
  user_Projects User_Projects[]
}

model Department {
  deptId   String              @id @unique @db.VarChar(30)
  name     String              @db.VarChar(50)
  compId   String
  company  Company             @relation(fields: [compId], references: [compId])
  users    User[]
  managers Departmen_Manager[]
}

model Departmen_Manager {
  deptId     String
  userId     String
  department Department @relation(fields: [deptId], references: [deptId])
  user       User       @relation(fields: [userId], references: [userId])

  @@id([deptId, userId])
}

model User_Projects {
  userId  String
  projId  String
  role    ProjectRole
  user    User        @relation(fields: [userId], references: [userId])
  project Project     @relation(fields: [projId], references: [projId])

  @@id([userId, projId])
}

model User_Relations {
  bossId         String
  subordinatedId String
  relation       Relation
  boss           User     @relation("BossRelations", fields: [bossId], references: [userId])
  subordinated   User     @relation("SubordinatedRelations", fields: [subordinatedId], references: [userId])

  @@id([bossId, subordinatedId])
}

enum Role {
  ADMIN
  WORKER
  OWNER
}

enum ProjectRole {
  BOSS
  WORKER
}

enum Relation {
  VIEW
  EDIT
}
