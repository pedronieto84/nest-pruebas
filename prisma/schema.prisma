// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId     Int         @id @unique @default(autoincrement())
  firebaseId String      @unique @db.VarChar(30)
  name       String      @db.VarChar(50)
  email      String      @unique @db.VarChar(50)
  role       Role        @default(WORKER)
  compId     Int?
  company    Company?    @relation(fields: [compId], references: [compId]) // Relación opcional con el modelo Company
  projects   Project[]   @relation("UserProjects")
  department Department? @relation(fields: [deptId], references: [deptId])
  deptId     Int?

  departmen_Manager Department_Manager[]
  user_Projects     User_Projects[]

  boss_relations User_Relations[] @relation("BossRelations")

  worker_relations User_Relations[] @relation("SubordinatedRelations")

  Records Records[]

  workerSettings WorkerSettings?
}

model Company {
  compId      Int          @id @unique @default(autoincrement())
  name        String       @db.VarChar(50)
  projects    Project[]
  departments Department[]
  users       User[]
}

model Project {
  projId        Int             @id @unique @default(autoincrement())
  name          String          @db.VarChar(50)
  compId        Int
  settings      String?
  company       Company         @relation(fields: [compId], references: [compId])
  users         User[]          @relation("UserProjects")
  user_Projects User_Projects[]

  Records Records[]
}

model Department {
  deptId   Int                  @id @unique @default(autoincrement())
  name     String               @db.VarChar(50)
  compId   Int
  company  Company              @relation(fields: [compId], references: [compId])
  users    User[]
  managers Department_Manager[]
}

model Department_Manager {
  deptId     Int
  userId     Int
  department Department @relation(fields: [deptId], references: [deptId])
  user       User       @relation(fields: [userId], references: [userId])

  @@id([deptId, userId])
}

model User_Projects {
  userId  Int
  projId  Int
  role    ProjectRole
  user    User        @relation(fields: [userId], references: [userId])
  project Project     @relation(fields: [projId], references: [projId])

  @@id([userId, projId])
}

model User_Relations {
  bossId         Int
  subordinatedId Int
  relation       Relation
  boss           User     @relation("BossRelations", fields: [bossId], references: [userId])
  subordinated   User     @relation("SubordinatedRelations", fields: [subordinatedId], references: [userId])

  @@id([bossId, subordinatedId])
}

model Records {
  recordId Int      @id @unique @default(autoincrement())
  userId   Int
  projId   Int
  start    DateTime
  end      DateTime
  seconds  Int

  position RecordPosition
  day      String         @db.VarChar(12)
  time     String         @db.VarChar(12)
  visible  Boolean
  type     RecordType

  user    User    @relation(fields: [userId], references: [userId])
  project Project @relation(fields: [projId], references: [projId])

  RecordsDesktop RecordsDesktop[]
  RecordsMovile  RecordsMobile[]
}

model RecordsDesktop {
  recordId Int @id @unique

  keyboard    Int?
  mouseMove   Int?
  mouseClicks Int?

  image String?

  record Records @relation(fields: [recordId], references: [recordId])

  RecordsPrograms RecordsPrograms[]
}

model RecordsPrograms {
  recordProgrId Int            @id @unique @default(autoincrement())
  recordId      Int
  time          DateTime
  title         String
  keyboard      Int?
  mouseMove     Int?
  mouseClicks   Int?
  record        RecordsDesktop @relation(fields: [recordId], references: [recordId])
}

model RecordsMobile {
  recordId    Int     @id @unique
  record      Records @relation(fields: [recordId], references: [recordId])
  geoPosition String  @db.VarChar(20)
  video       String? @db.VarChar(50)
  foto        String? @db.VarChar(50)
}

model WorkerSettings {
  userId           Int      @id @unique
  wakeUp           Boolean?
  stopLockScreen   Boolean?
  stopOnSuspend    Boolean?
  stopOnLockScreen Boolean?
  hidden           Boolean?
  processes        Boolean?
  systemData       Boolean?
  ipLocation       Boolean?
  internetSpeed    Boolean?
  alwaysAwake      Boolean?
  conexion         Boolean?
  shutdown         Boolean?
  screenshotView   Boolean?
  activityView     Boolean?
  processesView    Boolean?
  systemDataView   Boolean?
  resetComment     Boolean?
  gpsView          Boolean?
  callsView        Boolean?
  stopOnInactive   Boolean?
  screenshot       Boolean?
  activity         Boolean?
  calls            Boolean?
  gps              Boolean?
  recordsPhone     Int?
  gpsPrecision     Int?
  recWithoutMov    Boolean?
  forceAwake       Boolean?
  awakeEvery       Int?
  gpsTime          Int?
  menuConexion     Boolean?
  menuPanel        Boolean?
  menuGraficos     Boolean?
  menuHorarios     Boolean?
  menuSemanal      Boolean?
  menuEquipo       Boolean?
  menuProyectos    Boolean?
  menuOficina      Boolean?
  menuInformes     Boolean?
  menuPartner      Boolean?

  user User @relation(fields: [userId], references: [userId])
}

enum Role {
  ADMIN
  WORKER
  OWNER
}

enum ProjectRole {
  BOSS
  WORKER
}

enum Relation {
  VIEW
  EDIT
}

enum RecordPosition {
  START
  END
  MIDDLE
}

enum RecordType {
  DESKTOP
  MOBILE
}
