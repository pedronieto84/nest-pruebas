// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId     Int         @id @unique @default(autoincrement())
  firebaseId String      @unique @db.VarChar(30)
  name       String      @db.VarChar(50)
  email      String      @unique @db.VarChar(50)
  role       Role        @default(WORKER)
  compId     Int?
  company    Company?    @relation(fields: [compId], references: [compId]) // Relación opcional con el modelo Company
  projects   Project[]   @relation("UserProjects")
  department Department? @relation(fields: [deptId], references: [deptId])
  deptId     Int?

  departmen_Manager Department_Manager[]
  user_Projects     User_Projects[]

  boss_relations User_Relations[] @relation("BossRelations")

  worker_relations User_Relations[] @relation("SubordinatedRelations")

  Records Records[]

  workerSettings WorkerSettings?
}

model Company {
  compId      Int          @id @unique @default(autoincrement())
  name        String       @db.VarChar(50)
  projects    Project[]
  departments Department[]
  users       User[]
}

model Project {
  projId        Int             @id @unique @default(autoincrement())
  name          String          @db.VarChar(50)
  compId        Int
  settings      String?
  company       Company         @relation(fields: [compId], references: [compId])
  users         User[]          @relation("UserProjects")
  user_Projects User_Projects[]

  Records Records[]
}

model Department {
  deptId   Int                  @id @unique @default(autoincrement())
  name     String               @db.VarChar(50)
  compId   Int
  company  Company              @relation(fields: [compId], references: [compId])
  users    User[]
  managers Department_Manager[]
}

model Department_Manager {
  deptId     Int
  userId     Int
  department Department @relation(fields: [deptId], references: [deptId])
  user       User       @relation(fields: [userId], references: [userId])

  @@id([deptId, userId])
}

model User_Projects {
  userId  Int
  projId  Int
  role    ProjectRole
  user    User        @relation(fields: [userId], references: [userId])
  project Project     @relation(fields: [projId], references: [projId])

  @@id([userId, projId])
}

model User_Relations {
  bossId         Int
  subordinatedId Int
  relation       Relation
  boss           User     @relation("BossRelations", fields: [bossId], references: [userId])
  subordinated   User     @relation("SubordinatedRelations", fields: [subordinatedId], references: [userId])

  @@id([bossId, subordinatedId])
}

model Records {
  recordId Int      @id @unique @default(autoincrement())
  userId   Int
  projId   Int
  start    DateTime
  end      DateTime
  seconds  Int

  position RecordPosition
  day      String         @db.VarChar(12)
  time     String         @db.VarChar(12)
  visible  Boolean
  type     RecordType

  user    User    @relation(fields: [userId], references: [userId])
  project Project @relation(fields: [projId], references: [projId])

  RecordsDesktop RecordsDesktop[]
  RecordsMovile  RecordsMobile[]

  RecordsSystem RecordsSystem[]
}

model RecordsDesktop {
  recordId Int @id @unique

  keyboard    Int?
  mouseMove   Int?
  mouseClicks Int?

  image String?

  record Records @relation(fields: [recordId], references: [recordId])

  RecordsPrograms RecordsPrograms[]
}

model RecordsPrograms {
  recordProgrId Int            @id @unique @default(autoincrement())
  recordId      Int
  time          DateTime
  title         String
  keyboard      Int?
  mouseMove     Int?
  mouseClicks   Int?
  record        RecordsDesktop @relation(fields: [recordId], references: [recordId])
}

model RecordsMobile {
  recordId    Int     @id @unique
  record      Records @relation(fields: [recordId], references: [recordId])
  geoPosition String  @db.VarChar(20)
  video       String? @db.VarChar(50)
  foto        String? @db.VarChar(50)
}

model RecordsSystem {
  recordId Int @id @unique

  cpuUsage    Float?
  ramUsage    Float?
  diskUsage   Float?
  netUsage    Float?
  processes Json?
  record Records @relation(fields: [recordId], references: [recordId])
}

model WorkerSettings {
  userId           Int      @id @unique
  wakeUp           Boolean? @default(false)
  stopLockScreen   Boolean? @default(true)
  stopOnSuspend    Boolean? @default(true)
  stopOnLockScreen Boolean? @default(true)
  hidden           Boolean? @default(false)

  processes        Boolean? @default(true)
  systemData       Boolean? @default(true)

  internetSpeed    Boolean? @default(true)
  alwaysAwake      Boolean? @default(true)
  conexion         Boolean? @default(true)
  shutdown         Boolean? @default(true)
  
  screenshotView   Boolean? @default(true)
  activityView     Boolean? @default(true)
  processesView    Boolean? @default(true)
  systemDataView   Boolean? @default(true)
  gpsView          Boolean? @default(true)
  callsView        Boolean? @default(true)
  
  stopOnInactive   Boolean? @default(true)
  screenshot       Boolean? @default(true)
  activity         Boolean? @default(true)
  calls            Boolean? @default(true)
  gps              Boolean? @default(true)
  recordsPhone     Int? @default(3)
  gpsPrecision     Int? @default(2)
  recWithoutMov    Boolean? @default(true)
  forceAwake       Boolean? @default(true)
  awakeEvery       Int? @default(15)
  gpsTime          Boolean? @default(true)

  menuConexion     Boolean? @default(true)
  menuPanel        Boolean? @default(true)
  menuGraficos     Boolean? @default(true)
  menuHorarios     Boolean? @default(true)
  menuSemanal      Boolean? @default(true)
  menuEquipo       Boolean? @default(true)
  menuProyectos    Boolean? @default(true)
  menuOficina      Boolean? @default(true)
  menuInformes     Boolean? @default(true)
  menuPartner      Boolean? @default(true)

  resetComment     Boolean? @default(true)

  user User @relation(fields: [userId], references: [userId])
}

enum Role {
  ADMIN
  WORKER
  OWNER
}

enum ProjectRole {
  BOSS
  WORKER
}

enum Relation {
  VIEW
  EDIT
}

enum RecordPosition {
  START
  END
  MIDDLE
}

enum RecordType {
  DESKTOP
  MOBILE
}
